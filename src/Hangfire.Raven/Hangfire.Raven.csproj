<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>5.0.0</Version>
    <AssemblyName>Hangfire.Raven</AssemblyName>
    <PackageId>Hangfire.Raven</PackageId>
    <Description>RavenDB job storage for Hangfire</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Cady IO</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageTags>Hangfire;RavenDB;Background;Jobs;Scheduler;Queues</PackageTags>
    <PackageProjectUrl>https://github.com/stevehansen/hangfire-ravendb</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevehansen/hangfire-ravendb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="RavenDB.Client" />
  </ItemGroup>

</Project>
